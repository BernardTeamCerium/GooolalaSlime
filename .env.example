# Copy to .env and fill in. Never commit the real .env file.

# Public URL of the site (used for Stripe redirects and product images)
BASE_URL=http://localhost:4242
PORT=4242

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Use sk_test_... while testing, sk_live_... when you launch.
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the webhook endpoint you add in the dashboard
STRIPE_WEBHOOK_SECRET=
# Set to true after turning on Stripe Tax in the dashboard
STRIPE_AUTOMATIC_TAX=false

# --- Pricing & shipping (all amounts in cents) ---
PRICE_CENTS=800
SHIPPING_CENTS=500
# Orders at or above this subtotal ship free (0 = never free)
FREE_SHIPPING_FROM_CENTS=3200
# Comma-separated country codes you ship to
SHIP_COUNTRIES=US

# --- Email (any SMTP provider: Resend, Postmark, SendGrid, Google Workspace...) ---
# Leave SMTP_HOST empty to save emails to email-previews/ instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Gooolala! <hello@gooolala.com>"
EMAIL_REPLY_TO=hello@gooolala.com
# Where new-order alerts go
OWNER_EMAIL=
