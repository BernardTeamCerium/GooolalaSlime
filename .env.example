# Local testing: copy to .env and fill in. Never commit the real .env file.
# On Netlify: add these same names under Site configuration → Environment variables.

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Use sk_test_... while testing, sk_live_... when you launch.
STRIPE_SECRET_KEY=
# The signing secret of your webhook endpoint (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Sales tax by the buyer's location. Needs Stripe Tax turned on with your origin address.
STRIPE_AUTOMATIC_TAX=true

# --- Product, pricing & shipping (amounts in cents) ---
PRICE_CENTS=800
SHIPPING_CENTS=500
# Subtotal that ships free (0 = never free)
FREE_SHIPPING_FROM_CENTS=0
SHIP_COUNTRIES=US
# Days Aviana needs to make an order, plus days in the mail (for the delivery estimate)
MAKE_DAYS=3
TRANSIT_DAYS_MIN=2
TRANSIT_DAYS_MAX=5
# Jars-sold goal shown on the page
SALES_GOAL=100

# --- Email (any SMTP provider: Resend, Postmark, SendGrid, Google Workspace...) ---
# Leave SMTP_HOST empty locally to save emails to email-previews/ instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Gooolala! <hello@gooolala.com>"
EMAIL_REPLY_TO=hello@gooolala.com
# Where new-order alerts go
OWNER_EMAIL=hello@gooolala.com

# Public site address. Netlify fills this in automatically as URL; only set it to override.
# BASE_URL=https://gooolala.com
PORT=4242
